{
  "name": "oryx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e": "playwright test",
    "postinstall": "node -e \"if(!process.env.CI && !process.env.VERCEL) require('child_process').execSync('playwright install chromium', {stdio:'inherit'})\"",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:uat": "node -e \"require('fs').rmSync('.data/oryx.db',{force:true}); require('fs').rmSync('.data/oryx.db-shm',{force:true}); require('fs').rmSync('.data/oryx.db-wal',{force:true}); require('fs').rmSync('backups',{recursive:true,force:true})\" && npx tsx prisma/uat-seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('.data/oryx.db',{force:true}); require('fs').rmSync('.data/oryx.db-shm',{force:true}); require('fs').rmSync('.data/oryx.db-wal',{force:true})\" && npx tsx prisma/seed.ts",
    "db:check": "node scripts/check-db.mjs",
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase:verify-clients": "node scripts/verify-clients-migration.mjs",
    "supabase:sync-clients": "node scripts/sync-clients-to-supabase.mjs",
    "supabase:verify-jobs": "node scripts/verify-jobs-migration.mjs",
    "supabase:sync-jobs": "node scripts/sync-jobs-to-supabase.mjs",
    "supabase:verify-quotes": "node scripts/verify-quotes-migration.mjs",
    "supabase:sync-quotes": "node scripts/sync-quotes-to-supabase.mjs",
    "supabase:verify-status-history": "node scripts/verify-status-history-migration.mjs",
    "supabase:sync-status-history": "node scripts/sync-status-history-to-supabase.mjs",
    "supabase:verify-holds": "node scripts/verify-holds-migration.mjs",
    "supabase:sync-holds": "node scripts/sync-holds-to-supabase.mjs",
    "supabase:verify-billing": "node scripts/verify-billing-migration.mjs",
    "supabase:sync-billing": "node scripts/sync-billing-to-supabase.mjs",
    "supabase:verify-calendar": "node scripts/verify-calendar-migration.mjs",
    "supabase:sync-calendar": "node scripts/sync-calendar-to-supabase.mjs",
    "supabase:verify-users": "node scripts/verify-users-migration.mjs",
    "supabase:sync-users": "node scripts/sync-users-to-supabase.mjs",
    "supabase:verify-identity-log": "node scripts/verify-identity-log-migration.mjs",
    "supabase:sync-identity-log": "node scripts/sync-identity-log-to-supabase.mjs",
    "supabase:verify-backups": "node scripts/verify-backups-migration.mjs",
    "supabase:sync-backups": "node scripts/sync-backups-to-supabase.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@paralleldrive/cuid2": "^3.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
