// REFERENCE ONLY — this file is NOT used at runtime.
//
// The app stores data in SQLite via better-sqlite3 (see lib/db.ts).
// The real schema, migrations, and queries all live in lib/db/connection.ts
// and lib/db/schema.ts. This file exists only as a rough table outline for
// tools that expect a Prisma schema. Do not trust it as the source of truth.
//
// Seed scripts: prisma/seed.ts, prisma/uat-seed.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id            String    @id @default(cuid())
  drawingNumber String    @unique
  address       String
  typeOfWorks   String
  clientCompany String
  requestedBy   String
  status        String    @default("NEW_REQUEST")
  designer      String
  dateCreated   DateTime  @default(now())
  dateCompleted DateTime?
  invoiceStatus String    @default("NOT_INVOICED")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([clientCompany])
  @@index([designer])
}

model DrawingSequence {
  id        String @id @default(cuid())
  yearMonth String @unique
  sequence  Int    @default(0)
}
