# Copy to .env.local for local development.
# See README.md for the Vercel production checklist.

# SQLite database path (optional — defaults to .data/oryx.db)
# DB_PATH=/path/to/oryx.db

# ── Required in production (Vercel) ──────────────────────────────────────────
# AUTH_SECRET=              # Session cookies — openssl rand -base64 32
# VAULT_ENCRYPTION_KEY=     # Password vault — openssl rand -base64 32
# BACKUP_DOWNLOAD_SECRET=   # Backup download links — openssl rand -base64 32
# COOKIE_SECURE=true        # HTTPS-only cookies
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ORS_API_KEY=              # Site visit routing (OpenRouteService) — required in prod

AUTH_SECRET=

COOKIE_SECURE=false

BACKUP_DOWNLOAD_SECRET=

VAULT_ENCRYPTION_KEY=

# Optional: forward structured error logs to an HTTP webhook (Slack incoming webhook,
# Datadog, Discord, etc.). Recommended in production — fires from apiInternalError / logError.
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# Backup files directory (optional — defaults to ./backups or /tmp/backups on Vercel)
# BACKUPS_DIR=/path/to/backups

# Employee uploaded files directory (optional)
# EMPLOYEE_FILES_DIR=/path/to/employee-files

# Supabase — production database (Vercel + Supabase)
# When SUPABASE_SERVICE_ROLE_KEY is set, isSupabaseOnly() is true and modules
# use Supabase routers. Omit the service role key for SQLite-only local/CI.
# FORCE_SUPABASE_ONLY=true ignores per-module SUPABASE_*=false (same as VERCEL=1).
# See docs/sqlite-sunset.md.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# FORCE_SUPABASE_ONLY=false

# Site visit calculator — OpenRouteService API key (recommended for production routing)
# ORS_API_KEY=

# Per-module overrides (optional — default is ON when service role is set)
# SUPABASE_CLIENTS=false
# SUPABASE_JOBS=false
# SUPABASE_QUOTES=false
# SUPABASE_STATUS_HISTORY=false
# SUPABASE_HOLDS=false
# SUPABASE_BILLING=false
# SUPABASE_CALENDAR=false
# SUPABASE_USERS=false
# SUPABASE_IDENTITY_LOG=false
# SUPABASE_BACKUPS=false
# SUPABASE_EMPLOYEES=false
# SUPABASE_LEAVE=false
# SUPABASE_PASSWORD_VAULT=false
# SUPABASE_SITE_VISIT_CALCULATIONS=false

# Create admin@test.com / engineer@test.com with known dev passwords on startup.
# Never set true in production.
# ALLOW_BOOTSTRAP_TEST_ACCOUNTS=false
