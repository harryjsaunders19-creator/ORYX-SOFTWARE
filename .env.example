# Copy to .env.local for local development.
# See synology.env for a production (Synology/Docker) example.

# SQLite database path (optional — defaults to .data/oryx.db)
# DB_PATH=/path/to/oryx.db

# Signs session cookies — required in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Marks cookies Secure (HTTPS only). Set true in production behind HTTPS.
COOKIE_SECURE=false

# Signs time-limited backup download links — required in production.
# Generate with: openssl rand -base64 32
BACKUP_DOWNLOAD_SECRET=

# Encrypts password vault secrets at rest — required in production.
# Generate with: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=

# Backup files directory (optional — defaults to ./backups or /tmp/backups on Vercel)
# BACKUPS_DIR=/path/to/backups

# Employee uploaded files directory (optional)
# EMPLOYEE_FILES_DIR=/path/to/employee-files

# Supabase — production database (Vercel + Supabase)
# When SUPABASE_SERVICE_ROLE_KEY is set, modules read from Supabase by default.
# Opt out a module with SUPABASE_<MODULE>=false. Omit service role key for SQLite-only dev.
# NEXT_PUBLIC_SUPABASE_URL=          # or NEXT_PUBLIC_SUPABASE_URL from Vercel integration
# NEXT_PUBLIC_SUPABASE_ANON_KEY=     # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (Vercel integration)
# SUPABASE_SERVICE_ROLE_KEY=         # or SUPABASE_SECRET_KEY (Vercel integration)

# Per-module overrides (optional — default is ON when service role is set)
# SUPABASE_CLIENTS=false
# SUPABASE_JOBS=false
# SUPABASE_QUOTES=false
# SUPABASE_STATUS_HISTORY=false
# SUPABASE_HOLDS=false
# SUPABASE_BILLING=false
# SUPABASE_CALENDAR=false
# SUPABASE_USERS=false
# SUPABASE_IDENTITY_LOG=false
# SUPABASE_BACKUPS=false
# SUPABASE_EMPLOYEES=false
# SUPABASE_LEAVE=false

# Create admin@test.com / engineer@test.com with known dev passwords on startup.
# Never set true in production.
# ALLOW_BOOTSTRAP_TEST_ACCOUNTS=false
