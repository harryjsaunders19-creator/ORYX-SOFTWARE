# Copy this file to .env.local on the Synology server.
# This puts the database OUTSIDE the project directory so deployments
# (git pull, npm install, etc.) can never overwrite it.
DB_PATH=/volume1/docker/oryx-data/oryx.db
BACKUPS_DIR=/volume1/docker/oryx-data/backups

# Signs session cookies — prevents cookie forgery. Required in production.
# Generate a unique value on the server with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_YOUR_OWN_SECRET

# Marks cookies Secure (HTTPS only). Required in production.
COOKIE_SECURE=true
